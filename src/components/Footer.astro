<style>
  .site-footer {
    margin-top: 6rem;
    border-top: 1px solid #D1E0ED;
    background: #FFFFFF;
    padding-block: 3rem 2rem;
  }

  .container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1.8fr 1.2fr;
    gap: 3rem;
    padding-bottom: 2rem;
  }

  /* Brand Section */
  .brand-logo {
    display: block;
    height: 48px;
    width: auto;
    margin-bottom: 1rem;
  }

  .footer-brand .brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: #0F3B66;
    text-decoration: none;
    border: none;
  }

  .brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: linear-gradient(135deg, #0F3B66, #06B6D4);
    color: white;
    font-family: system-ui, -apple-system, sans-serif;
    font-weight: 800;
    font-size: 0.78rem;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .brand-name {
    font-family: system-ui, -apple-system, sans-serif;
    font-weight: 700;
    font-size: 1rem;
    color: #0F3B66;
  }

  .bio {
    color: #334155;
    font-size: 0.92rem;
    line-height: 1.65;
    margin: 0 0 1.5rem;
    max-width: 50ch;
  }

  /* Social Links */
  .social-links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .social-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #E8F2F8;
    color: #0F3B66;
    text-decoration: none;
    transition: all 0.2s ease;
    border: 1px solid #D1E0ED;
  }

  .social-icon svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  .social-icon:hover {
    background: #06B6D4;
    color: #FFFFFF;
    border-color: #06B6D4;
    transform: translateY(-2px);
  }

  .social-icon.topmate {
    background: linear-gradient(135deg, #0F3B66, #06B6D4);
    color: white;
    border-color: #06B6D4;
  }

  .social-icon.topmate:hover {
    background: linear-gradient(135deg, #06B6D4, #0F3B66);
  }

  /* Navigation Section */
  .footer-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .nav-section h4 {
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    color: #0F3B66;
    margin: 0 0 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .nav-section a {
    display: block;
    font-size: 0.9rem;
    color: #334155;
    text-decoration: none;
    margin-bottom: 0.75rem;
    transition: color 0.2s ease;
  }

  .nav-section a:hover {
    color: #06B6D4;
  }

  /* Legal Section */
  .footer-legal {
    border-top: 1px solid #D1E0ED;
    padding-top: 2rem;
    margin-top: 2rem;
  }

  .footer-legal p {
    margin: 0;
    color: #64748B;
    font-size: 0.8rem;
    line-height: 1.6;
  }

  .footer-legal p:first-child {
    margin-bottom: 0.5rem;
    font-weight: 600;
  }

  .disclaimer {
    font-style: italic;
    color: #64748B;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .footer-nav {
      grid-template-columns: 1fr;
    }

    .social-links {
      justify-content: flex-start;
    }

    .site-footer {
      padding-block: 2rem 1.5rem;
    }
  }

  @media (max-width: 640px) {
    .brand-logo {
      height: 40px;
    }

    .social-icon {
      width: 36px;
      height: 36px;
    }

    .social-icon svg {
      width: 18px;
      height: 18px;
    }
  }
</style>
