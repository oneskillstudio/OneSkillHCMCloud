---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);

  const tagSet = new Set<string>();
  for (const post of posts) for (const t of post.data.tags) tagSet.add(t);

  const fuzzyCategories = [
    'Fast Formula',
    'OTL',
    'Benefits',
    'HDL',
    'Recruiting',
    'Null Handling',
    'Absence Management',
    'Time and Labor',
  ];

  // Category aliases — one chip gathers several underlying tags and title keywords.
  const categoryAliases: Record<string, string[]> = {
    OTL: [
      'otl',
      'time & labor',
      'time and labor',
      'time entry rule',
      'time calculation rule',
      'timecard',
      'tcr deep dive',
    ],
  };
  for (const c of fuzzyCategories) tagSet.add(c);

  return Array.from(tagSet).map((tag) => {
    const slug = tag.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
    const needle = tag.toLowerCase();
    const aliases = categoryAliases[tag];

    let matched;

    if (aliases) {
      matched = posts.filter((p) => {
        const haystack = (p.data.tags.join(' ') + ' ' + p.data.title).toLowerCase();
        return aliases.some((a) => haystack.includes(a));
      });
    } else {
      matched = posts.filter((p) =>
        p.data.tags.some((t) => t.toLowerCase() === needle)
      );

      if (matched.length === 0) {
        matched = posts.filter((p) => {
          const haystack = (p.data.tags.join(' ') + ' ' + p.data.title).toLowerCase();
          return haystack.includes(needle);
        });
      }
    }

    matched.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

    return { params: { tag: slug }, props: { tag, posts: matched } };
  });
}

const { tag, posts } = Astro.props;
const currentSlug = Astro.params.tag;

const formatShort = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

// Same category logic as the homepage — word boundaries so "patterns" doesn't match "ter".
const primaryCategory = (tags: string[], title: string): string => {
  const all = (tags.join(' ') + ' ' + title).toLowerCase();
  if (all.includes('hdl')) return 'HDL';
  if (all.includes('benefit')) return 'Benefits';
  if (all.includes('recruit')) return 'Recruiting';
  if (all.includes('absence')) return 'Absence';
  if (
    all.includes('time and labor') ||
    all.includes('time & labor') ||
    all.includes('time entry rule') ||
    all.includes('time calculation rule') ||
    all.includes('timecard') ||
    /\btcr\b/.test(all) ||
    /\bter\b/.test(all)
  ) return 'Time & Labor';
  if (all.includes('null') || all.includes('defaulted')) return 'Null Handling';
  if (tags.length > 0) return tags[0];
  return 'Fast Formula';
};

const readMinutes = (body: string): number =>
  Math.max(1, Math.ceil(body.trim().split(/\s+/).length / 200));

const depth = (mins: number) =>
  mins >= 18
    ? { label: 'Deep', bars: '▰▰▰', cls: 'd3' }
    : mins >= 9
    ? { label: 'Applied', bars: '▰▰▱', cls: 'd2' }
    : { label: 'Foundational', bars: '▰▱▱', cls: 'd1' };

const cards = posts.map((post) => {
  const mins = readMinutes(post.body);
  return {
    slug: post.slug,
    title: post.data.title,
    description: post.data.description,
    pubDate: post.data.pubDate,
    mins,
    tier: depth(mins),
    category: primaryCategory(post.data.tags, post.data.title),
  };
});

const featured = cards[0];
const rest = cards.slice(1);

const chips = [
  { href: '/', label: 'All', slug: null },
  { href: '/tags/otl', label: 'OTL', slug: 'otl' },
  { href: '/tags/fast-formula', label: 'Fast Formula', slug: 'fast-formula' },
  { href: '/tags/hdl', label: 'HDL', slug: 'hdl' },
  { href: '/tags/benefits', label: 'Benefits', slug: 'benefits' },
  { href: '/tags/recruiting', label: 'Recruiting', slug: 'recruiting' },
  { href: '/tags/null-handling', label: 'Null Handling', slug: 'null-handling' },
];
---

<BaseLayout title={tag} description={`Posts about ${tag}`}>
  <div class="hp">

    <!-- ══════════ CATEGORY BAND ══════════ -->
    <section class="hp-shell">
      <div class="band">
        <div class="band-inner">
          <div class="hp-eyebrow">Category</div>
          <h1>{tag}</h1>
          <p class="band-sub">
            {posts.length} {posts.length === 1 ? 'article' : 'articles'} in this category.
          </p>
        </div>
      </div>
    </section>

    <!-- ══════════ FILTER ══════════ -->
    <div class="filter-wrap">
      <div class="hp-shell filter-inner">
        <span class="filter-label">Filter</span>
        <nav class="filter-scroll" aria-label="Categories">
          {chips.map((c) => (
            <a
              href={c.href}
              class={currentSlug === c.slug ? 'chip is-active' : 'chip'}
              aria-current={currentSlug === c.slug ? 'page' : undefined}
            >{c.label}</a>
          ))}
        </nav>
      </div>
    </div>

    <!-- ══════════ FEED ══════════ -->
    <section class="hp-shell feed">
      <div class="feed-head">
        <h2>{tag}</h2>
        <span class="feed-count">{posts.length} {posts.length === 1 ? 'article' : 'articles'}</span>
      </div>

      {posts.length === 0 ? (
        <div class="empty">
          <p>No posts in this category yet.</p>
          <p><a class="back" href="/">← Back to all articles</a></p>
        </div>
      ) : (
        <div class="bento">
          {featured && (
            <a href={`/posts/${featured.slug}`} class="card card--feature">
              <div class="card-eyebrow"><span class="arrow">&gt;&gt;&gt;</span> {featured.category} · Latest</div>
              <h3>{featured.title}</h3>
              {featured.description && <p>{featured.description}</p>}
              <span class="read-cta">Start reading <span aria-hidden="true">→</span></span>
              <div class="card-foot">
                <span class="pill">{featured.mins} min</span>
                <span class={`pill tier ${featured.tier.cls}`}><span class="bars">{featured.tier.bars}</span> {featured.tier.label}</span>
                <span class="pill">{formatShort(featured.pubDate)}</span>
              </div>
            </a>
          )}

          {rest.map((c) => (
            <a href={`/posts/${c.slug}`} class="card">
              <div class="card-eyebrow"><span class="arrow">&gt;&gt;&gt;</span> {c.category}</div>
              <h3>{c.title}</h3>
              {c.description && <p>{c.description}</p>}
              <div class="card-foot">
                <span class="pill">{c.mins} min</span>
                <span class={`pill tier ${c.tier.cls}`}><span class="bars">{c.tier.bars}</span> {c.tier.label}</span>
              </div>
            </a>
          ))}
        </div>
      )}
    </section>

  </div>
</BaseLayout>

<style>
  /* Mirrors src/pages/index.astro so category pages match the homepage. */
  .hp{
    --hp-bg:#FDF6EE; --hp-surface:#FFFFFF; --hp-surface-2:#F7EFE4;
    --hp-line:#E6DACA; --hp-line-soft:#EFE6D9;
    --hp-navy:#003060; --hp-ink:#0A2A4A; --hp-dim:#56687E; --hp-faint:#8A98A8;
    --hp-blue:#184878; --hp-blue-lift:#186090;
    --hp-orange:#F07818; --hp-orange-dp:#C05A10;
    --hp-orange-wash:rgba(240,120,24,.09); --hp-orange-edge:rgba(240,120,24,.42);
    --hp-d1:#0F766E; --hp-d2:#C05A10; --hp-d3:#A3232B;
    --hp-f:Verdana, Geneva, 'DejaVu Sans', sans-serif;

    background:var(--hp-bg); color:var(--hp-ink);
    font-family:var(--hp-f); font-size:15px; line-height:1.68;
    padding-block:26px 0;
  }
  .hp *{box-sizing:border-box}
  .hp-shell{max-width:1180px;margin:0 auto;padding:0 24px}

  /* ── band ── */
  .band{
    position:relative;margin:0 0 30px;
    background:
      radial-gradient(70% 120% at 88% 20%, rgba(24,72,120,.05), transparent 60%),
      linear-gradient(180deg,#FFFCF8 0%, var(--hp-surface-2) 100%);
    border:1px solid var(--hp-line);border-radius:18px;overflow:hidden;
  }
  .band::before{
    content:'';position:absolute;inset:0 0 auto 0;height:3px;
    background:linear-gradient(90deg,var(--hp-navy) 0%, var(--hp-blue-lift) 46%, var(--hp-orange) 100%);
  }
  .band-inner{padding:30px 34px 28px}
  .hp-eyebrow{
    background:none;padding:0;border-radius:0;   /* beat global .eyebrow pill */
    font-size:10.5px;font-weight:700;letter-spacing:.15em;text-transform:uppercase;
    color:var(--hp-orange-dp);margin-bottom:12px;display:flex;align-items:center;gap:12px;
  }
  .hp-eyebrow::after{
    content:'';height:2px;flex:1;max-width:120px;border-radius:2px;
    background:linear-gradient(90deg,var(--hp-orange),transparent);
  }
  .hp h1{
    font-family:var(--hp-f);font-weight:700;
    font-size:clamp(1.7rem,3.1vw,2.4rem);
    line-height:1.12;letter-spacing:-.035em;color:var(--hp-navy);margin:0 0 8px;
  }
  .band-sub{font-size:14px;color:var(--hp-dim);margin:0}

  /* ── filter ── */
  .filter-wrap{
    position:sticky;top:0;z-index:30;
    background:rgba(253,246,238,.9);
    backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);
    border-top:1px solid var(--hp-line-soft);border-bottom:1px solid var(--hp-line);
  }
  .filter-inner{display:flex;align-items:center;gap:14px;padding:12px 24px}
  .filter-label{
    font-size:10px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;
    color:var(--hp-faint);white-space:nowrap;flex-shrink:0;
  }
  .filter-scroll{display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;padding:2px 0}
  .filter-scroll::-webkit-scrollbar{display:none}
  .hp .chip{
    display:inline-flex;align-items:center;gap:7px;
    padding:8px 14px;border:1px solid var(--hp-line);border-radius:999px;
    background:var(--hp-surface);color:var(--hp-dim);text-decoration:none;
    font-size:11.5px;font-weight:700;letter-spacing:-.01em;white-space:nowrap;
    transition:border-color .18s ease,color .18s ease,background .18s ease;
  }
  .hp .chip:hover{color:var(--hp-orange-dp);border-color:var(--hp-orange-edge)}
  .hp .chip.is-active{background:var(--hp-navy);border-color:var(--hp-navy);color:#fff}

  /* ── feed ── */
  .feed{padding:38px 24px 80px}
  .feed-head{display:flex;align-items:baseline;justify-content:space-between;gap:16px;margin-bottom:20px}
  .hp .feed-head h2{
    font-family:var(--hp-f);font-weight:700;font-size:18px;
    letter-spacing:-.025em;color:var(--hp-navy);margin:0;
  }
  .feed-count{font-size:11px;color:var(--hp-faint)}
  .empty{color:var(--hp-dim);font-size:14px}
  .hp .back{color:var(--hp-orange-dp);font-weight:700;text-decoration:none}

  .bento{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
  .hp .card{
    position:relative;display:flex;flex-direction:column;
    background:var(--hp-surface);border:1px solid var(--hp-line);
    border-radius:14px;padding:22px;overflow:hidden;text-decoration:none;color:inherit;
    box-shadow:0 1px 2px rgba(10,42,74,.03);
    transition:border-color .2s ease,transform .2s ease,box-shadow .2s ease;
  }
  .hp .card:hover{
    border-color:var(--hp-orange-edge);transform:translateY(-2px);
    box-shadow:0 2px 4px rgba(10,42,74,.04), 0 16px 34px -20px rgba(10,42,74,.28);
  }
  .hp .card::after{
    content:'';position:absolute;inset:0 0 auto 0;height:3px;
    background:linear-gradient(90deg,var(--hp-navy),var(--hp-orange));
    opacity:0;transition:opacity .2s ease;
  }
  .hp .card:hover::after{opacity:1}
  .card-eyebrow{
    font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;
    color:var(--hp-orange-dp);margin-bottom:11px;display:flex;align-items:center;gap:7px;
  }
  .card-eyebrow .arrow{opacity:.7;letter-spacing:-.06em}
  .hp .card h3{
    font-family:var(--hp-f);font-weight:700;letter-spacing:-.028em;line-height:1.28;
    font-size:15.5px;margin:0 0 9px;color:var(--hp-navy);
  }
  .hp .card p{
    font-size:13px;color:var(--hp-dim);line-height:1.6;margin:0 0 18px;
    display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;
  }
  .hp .card-foot{
    font-family:var(--hp-f);          /* global .card-foot forces a mono stack */
    font-size:inherit;color:inherit;
    margin-top:auto;display:flex;align-items:center;gap:8px;flex-wrap:wrap;
    padding-top:14px;border-top:1px solid var(--hp-line-soft);
  }
  .hp .pill{
    font-family:var(--hp-f);
    display:inline-flex;align-items:center;gap:6px;font-size:10.5px;color:var(--hp-dim);
    background:var(--hp-surface-2);border:1px solid var(--hp-line-soft);
    border-radius:6px;padding:4px 9px;letter-spacing:-.005em;
  }
  .tier .bars{letter-spacing:.06em;font-weight:700}
  .d1 .bars{color:var(--hp-d1)}
  .d2 .bars{color:var(--hp-d2)}
  .d3 .bars{color:var(--hp-d3)}

  .card--feature{
    grid-column:span 2;grid-row:span 2;padding:30px;
    background:radial-gradient(78% 64% at 92% 3%, var(--hp-orange-wash), transparent 58%),var(--hp-surface);
  }
  .hp .card--feature h3{font-size:clamp(1.32rem,2.1vw,1.7rem);line-height:1.16;margin-bottom:14px}
  .hp .card--feature p{font-size:14px;max-width:48ch;margin-bottom:22px;-webkit-line-clamp:5}
  .read-cta{
    display:inline-flex;align-items:center;gap:8px;font-size:12px;font-weight:700;
    letter-spacing:-.01em;color:var(--hp-orange-dp);margin-bottom:20px;transition:gap .2s ease;
  }
  .card--feature:hover .read-cta{gap:13px}

  /* ── responsive ── */
  @media (max-width:1040px){
    .band-inner{padding:26px 26px 24px}
    .bento{grid-template-columns:repeat(2,1fr)}
    .card--feature{grid-column:span 2;grid-row:span 1}
  }
  @media (max-width:600px){
    .hp-shell{padding:0 16px}
    .filter-inner,.feed{padding-left:16px;padding-right:16px}
    .band{border-radius:14px;margin-bottom:24px}
    .band-inner{padding:22px 18px 20px}
    .bento{grid-template-columns:1fr;gap:13px}
    .card--feature{grid-column:span 1;padding:24px}
    .filter-label{display:none}
  }
  @media (prefers-reduced-motion:reduce){
    .hp *,.hp *::before,.hp *::after{transition-duration:.001ms !important}
  }
</style>
