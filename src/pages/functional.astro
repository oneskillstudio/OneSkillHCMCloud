
Functional · ASTRO
---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
 
const allPosts = await getCollection('posts');
const functionalPosts = allPosts
	.filter(post => post.data.category === 'Functional')
	.sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf());
 
const allTags = [...new Set(functionalPosts.flatMap(post => post.data.tags || []))];
---
 
<BaseLayout title="Functional Articles">
	<div class="container">
		<h1>Functional Articles</h1>
		<p class="subtitle">Configuration guides and best practices for Core HR, Payroll, Time & Labor, Benefits, and Recruiting.</p>
 
		<div class="posts-grid">
			{functionalPosts.map(post => (
				<article class="post-card">
					<div class="post-header">
						<span class="category-badge">Functional</span>
						<span class="date">{new Date(post.data.pubDate).toLocaleDateString()}</span>
					</div>
					
					<h2><a href={`/posts/${post.slug}`}>{post.data.title}</a></h2>
					<p class="description">{post.data.description}</p>
					
					<div class="tags">
						{post.data.tags?.map(tag => (
							<span class="tag">{tag}</span>
						))}
					</div>
					
					<a href={`/posts/${post.slug}`} class="read-more">Read Article →</a>
				</article>
			))}
		</div>
 
		{functionalPosts.length === 0 && (
			<div class="empty-state">
				<p>No functional articles found yet.</p>
			</div>
		)}
	</div>
</BaseLayout>
 
<style>
	.container {
		max-width: 1000px;
		margin: 0 auto;
		padding: 2rem 1rem;
	}
 
	h1 {
		font-size: 2.5rem;
		font-weight: 800;
		color: var(--ink-strong);
		margin: 0 0 0.5rem;
		letter-spacing: -0.02em;
	}
 
	.subtitle {
		font-size: 1.05rem;
		color: var(--ink-muted);
		line-height: 1.6;
		margin: 0 0 2rem;
		max-width: 600px;
	}
 
	.posts-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.5rem;
		margin-top: 2rem;
	}
 
	.post-card {
		background: var(--bg-elevated);
		border: 1px solid var(--border);
		border-radius: 10px;
		padding: 1.5rem;
		transition: all 0.2s;
	}
 
	.post-card:hover {
		border-color: var(--primary);
		box-shadow: 0 8px 30px rgba(0, 84, 179, 0.1);
		transform: translateY(-2px);
	}
 
	.post-header {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 1rem;
	}
 
	.category-badge {
		background: var(--accent-soft);
		color: var(--accent-dark);
		font-size: 11px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		padding: 3px 10px;
		border-radius: 99px;
	}
 
	.date {
		font-size: 12px;
		color: var(--ink-faint);
		font-family: var(--font-mono);
	}
 
	.post-card h2 {
		font-size: 1.4rem;
		font-weight: 700;
		color: var(--ink-strong);
		margin: 0 0 0.75rem;
		line-height: 1.35;
	}
 
	.post-card h2 a {
		text-decoration: none;
		color: inherit;
	}
 
	.post-card h2 a:hover {
		color: var(--primary);
	}
 
	.description {
		font-size: 14px;
		color: var(--ink-muted);
		line-height: 1.6;
		margin: 0 0 1rem;
	}
 
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 1rem 0;
	}
 
	.tag {
		background: var(--accent-soft);
		color: var(--accent);
		padding: 0.25rem 0.75rem;
		border-radius: 4px;
		font-size: 0.85rem;
		font-weight: 600;
	}
 
	.read-more {
		display: inline-block;
		color: var(--primary);
		text-decoration: none;
		font-weight: 500;
		font-size: 13px;
		transition: all 0.2s;
	}
 
	.read-more:hover {
		transform: translateX(4px);
	}
 
	.empty-state {
		text-align: center;
		padding: 3rem;
		color: var(--ink-muted);
	}
 
	@media (max-width: 640px) {
		.container {
			padding: 1rem;
		}
 
		h1 {
			font-size: 1.8rem;
		}
 
		.posts-grid {
			gap: 1rem;
		}
 
		.post-card {
			padding: 1rem;
		}
 
		.post-card h2 {
			font-size: 1.1rem;
		}
	}
</style>
 














