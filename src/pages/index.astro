              <rect x="348" y="268" width="112" height="15" rx="4" fill="#FFFFFF" stroke="#DCE4EC" stroke-width="1"></rect>
              <text x="404" y="278.5" text-anchor="middle" font-family="Verdana, sans-serif" font-size="7" font-weight="700" fill="#184878" letter-spacing="-.3">PER_FULL_PART_TIME</text>
            </g>

            <g>
              <rect x="326" y="14" width="94" height="52" rx="5" fill="#FFFFFF" stroke="#E6DACA" stroke-width="1" opacity=".97"></rect>
              <circle cx="339" cy="29" r="3.4" fill="#186090"></circle>
              <text x="349" y="32" font-family="Verdana, sans-serif" font-size="7.5" fill="#0A2A4A">Time FF</text>
              <circle cx="339" cy="43" r="3.4" fill="#003060"></circle>
              <text x="349" y="46" font-family="Verdana, sans-serif" font-size="7.5" fill="#0A2A4A">Global FF</text>
              <circle cx="339" cy="57" r="3.4" fill="#F07818"></circle>
