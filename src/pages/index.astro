    <!-- ══════════ FILTER ══════════ -->
    <div class="filter-wrap">
      <div class="hp-shell filter-inner">
        <span class="filter-label">Filter</span>
        <nav class="filter-scroll" aria-label="Categories">
          <a href="/" class="chip is-active">All <span class="chip-count">{allPosts.length}</span></a>
          <a href="/tags/otl" class="chip">OTL</a>
          <a href="/tags/fast-formula" class="chip">Fast Formula</a>
          <a href="/tags/hdl" class="chip">HDL</a>
          <a href="/tags/benefits" class="chip">Benefits</a>
          <a href="/tags/recruiting" class="chip">Recruiting</a>
          <a href="/tags/null-handling" class="chip">Null Handling</a>
        </nav>
      </div>
    </div>

    <!-- ══════════ FEED ══════════ -->
    <section class="hp-shell feed">
      <div class="feed-head">
        <h2>Latest</h2>
        <span class="feed-count">{allPosts.length} articles</span>
      </div>

      {allPosts.length === 0 ? (
        <p class="empty">No posts published yet.</p>
      ) : (
        <div class="bento">
          {featured && (() => {
            const d = cardData(featured);
            return (
              <a href={`/posts/${featured.slug}`} class="card card--feature">
                <div class="card-eyebrow"><span class="arrow">&gt;&gt;&gt;</span> {d.category} · Latest</div>
                <h3>{featured.data.title}</h3>
                {featured.data.description && <p>{featured.data.description}</p>}
                <span class="read-cta">Start reading <span aria-hidden="true">→</span></span>
                <div class="card-foot">
                  <span class="pill">{d.mins} min</span>
                  <span class={`pill tier ${d.tier.cls}`}><span class="bars">{d.tier.bars}</span> {d.tier.label}</span>
                  <span class="pill">{formatShort(featured.data.pubDate)}</span>
                </div>
              </a>
            );
          })()}

          {rest.map((post) => {
            const d = cardData(post);
            return (
              <a href={`/posts/${post.slug}`} class="card">
                <div class="card-eyebrow"><span class="arrow">&gt;&gt;&gt;</span> {d.category}</div>
                <h3>{post.data.title}</h3>
                {post.data.description && <p>{post.data.description}</p>}
                <div class="card-foot">
                  <span class="pill">{d.mins} min</span>
                  <span class={`pill tier ${d.tier.cls}`}><span class="bars">{d.tier.bars}</span> {d.tier.label}</span>
                </div>
              </a>
            );
          })}
        </div>
      )}
    </section>

  </div>
</BaseLayout>

<style>
  /* Scoped under .hp; class names prefixed where global.css already owns them. */
  .hp{
    --hp-bg:#FDF6EE; --hp-surface:#FFFFFF; --hp-surface-2:#F7EFE4;
    --hp-line:#E6DACA; --hp-line-soft:#EFE6D9;
    --hp-navy:#003060; --hp-ink:#0A2A4A; --hp-dim:#56687E; --hp-faint:#8A98A8;
    --hp-blue:#184878; --hp-blue-lift:#186090;
    --hp-orange:#F07818; --hp-orange-dp:#C05A10;
    --hp-orange-wash:rgba(240,120,24,.09); --hp-orange-edge:rgba(240,120,24,.42);
    --hp-d1:#0F766E; --hp-d2:#C05A10; --hp-d3:#A3232B;
    --hp-f:Verdana, Geneva, 'DejaVu Sans', sans-serif;

    background:var(--hp-bg); color:var(--hp-ink);
    font-family:var(--hp-f); font-size:15px; line-height:1.68;
    padding-block:26px 0;
  }
  .hp *{box-sizing:border-box}
  .hp-shell{max-width:1180px;margin:0 auto;padding:0 24px}

  /* ── band ── */
  .band{
    position:relative;margin:0 0 30px;
    background:
      radial-gradient(70% 120% at 88% 20%, rgba(24,72,120,.05), transparent 60%),
      linear-gradient(180deg,#FFFCF8 0%, var(--hp-surface-2) 100%);
    border:1px solid var(--hp-line);border-radius:18px;overflow:hidden;
  }
  .band::before{
    content:'';position:absolute;inset:0 0 auto 0;height:3px;
    background:linear-gradient(90deg,var(--hp-navy) 0%, var(--hp-blue-lift) 46%, var(--hp-orange) 100%);
  }
  .band-grid{
    display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.02fr);
    gap:30px;align-items:center;padding:34px 34px 30px;
  }
  .hp-eyebrow{
    background:none;padding:0;border-radius:0;   /* beat global .eyebrow pill */
    font-size:10.5px;font-weight:700;letter-spacing:.15em;text-transform:uppercase;
    color:var(--hp-orange-dp);margin-bottom:16px;display:flex;align-items:center;gap:12px;
  }
  .hp-eyebrow::after{
    content:'';height:2px;flex:1;max-width:120px;border-radius:2px;
    background:linear-gradient(90deg,var(--hp-orange),transparent);
  }
  .hp h1{
    font-family:var(--hp-f);font-weight:700;
    font-size:clamp(1.6rem,2.9vw,2.3rem);
    line-height:1.16;letter-spacing:-.035em;color:var(--hp-navy);margin:0 0 20px;
  }
  .hp h1 .accent{color:var(--hp-orange)}

  .concepts{display:grid;grid-template-columns:repeat(4,1fr);gap:9px;margin-bottom:20px}
  .concept{
    background:var(--hp-surface);border:1px solid var(--hp-line);
    border-radius:9px;padding:11px 11px 12px;
    transition:border-color .2s ease,transform .2s ease;
  }
  .concept:hover{border-color:var(--hp-orange-edge);transform:translateY(-2px)}
  .concept-n{
    font-size:9px;font-weight:700;letter-spacing:.07em;color:var(--hp-navy);
    text-transform:uppercase;line-height:1.35;margin-bottom:7px;display:block;
  }
  .concept-n b{color:var(--hp-orange);margin-right:3px}
  .concept ul{list-style:none;font-size:9.5px;color:var(--hp-dim);line-height:1.75;margin:0;padding:0}
  .concept li{position:relative;padding-left:9px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .concept li::before{
    content:'';position:absolute;left:0;top:7px;width:3px;height:3px;
    border-radius:50%;background:var(--hp-orange);
  }
  .concept .dbi{
    font-size:8.5px;color:var(--hp-blue);font-weight:700;letter-spacing:-.02em;
    line-height:1.7;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
  }

  .term{display:flex;align-items:center;gap:11px}
  .term-glyph{
    width:34px;height:34px;flex-shrink:0;background:var(--hp-navy);border-radius:7px;
    display:grid;place-items:center;color:var(--hp-orange);
    font-size:13px;font-weight:700;letter-spacing:-.08em;
  }
  .term-text{font-size:14px;font-weight:700;letter-spacing:-.025em;color:var(--hp-navy)}
  .term-text .br{color:var(--hp-orange)}
  .term-text .lo{font-weight:400;color:var(--hp-dim)}

  .diagram{width:100%;height:auto;display:block}
  .flow{stroke-dasharray:5 7;animation:hpflow 2.6s linear infinite}
  @keyframes hpflow{to{stroke-dashoffset:-24}}

  /* ── filter ── */
  .filter-wrap{
    position:sticky;top:0;z-index:30;
    background:rgba(253,246,238,.9);
    backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);
    border-top:1px solid var(--hp-line-soft);border-bottom:1px solid var(--hp-line);
  }
  .filter-inner{display:flex;align-items:center;gap:14px;padding:12px 24px}
  .filter-label{
    font-size:10px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;
    color:var(--hp-faint);white-space:nowrap;flex-shrink:0;
  }
  .filter-scroll{display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;padding:2px 0}
  .filter-scroll::-webkit-scrollbar{display:none}
  .hp .chip{
    display:inline-flex;align-items:center;gap:7px;
    padding:8px 14px;border:1px solid var(--hp-line);border-radius:999px;
    background:var(--hp-surface);color:var(--hp-dim);text-decoration:none;
    font-size:11.5px;font-weight:700;letter-spacing:-.01em;white-space:nowrap;
    transition:border-color .18s ease,color .18s ease,background .18s ease;
  }
  .hp .chip:hover{color:var(--hp-orange-dp);border-color:var(--hp-orange-edge)}
  .hp .chip.is-active{background:var(--hp-navy);border-color:var(--hp-navy);color:#fff}
  .chip-count{font-size:10px;opacity:.6;font-weight:400}

  /* ── feed ── */
  .feed{padding:38px 24px 80px}
  .feed-head{display:flex;align-items:baseline;justify-content:space-between;gap:16px;margin-bottom:20px}
  .hp .feed-head h2{
    font-family:var(--hp-f);font-weight:700;font-size:18px;
    letter-spacing:-.025em;color:var(--hp-navy);margin:0;
  }
  .feed-count{font-size:11px;color:var(--hp-faint)}
  .empty{color:var(--hp-faint);font-size:14px}

  .bento{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
  .hp .card{
    position:relative;display:flex;flex-direction:column;
    background:var(--hp-surface);border:1px solid var(--hp-line);
