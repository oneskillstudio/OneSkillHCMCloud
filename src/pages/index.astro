---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allPosts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const formatShort = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

// Primary category shown on each card.
// Note: matches whole words, so "patterns" no longer matches "ter".
const primaryCategory = (tags: string[], title: string): string => {
  const all = (tags.join(' ') + ' ' + title).toLowerCase();
  if (all.includes('hdl')) return 'HDL';
  if (all.includes('benefit')) return 'Benefits';
  if (all.includes('recruit')) return 'Recruiting';
  if (all.includes('absence')) return 'Absence';
  if (
    all.includes('time and labor') ||
    all.includes('time & labor') ||
    all.includes('time entry rule') ||
    all.includes('time calculation rule') ||
    all.includes('timecard') ||
    /\btcr\b/.test(all) ||
    /\bter\b/.test(all)
  ) return 'Time & Labor';
  if (all.includes('null') || all.includes('defaulted')) return 'Null Handling';
  if (tags.length > 0) return tags[0];
  return 'Fast Formula';
};

// Reading time from the post body — 200 wpm, rounded up.
const readMinutes = (body: string): number =>
  Math.max(1, Math.ceil(body.trim().split(/\s+/).length / 200));

// Depth tier, derived from length as a proxy. Add a `depth` field to the
// content schema later if you want to set this per post instead.
const depth = (mins: number) =>
  mins >= 18
    ? { label: 'Deep', bars: '▰▰▰', cls: 'd3' }
    : mins >= 9
    ? { label: 'Applied', bars: '▰▰▱', cls: 'd2' }
    : { label: 'Foundational', bars: '▰▱▱', cls: 'd1' };

const featured = allPosts[0];
const rest = allPosts.slice(1);

const cardData = (post: typeof allPosts[number]) => {
  const mins = readMinutes(post.body);
  return { mins, tier: depth(mins), category: primaryCategory(post.data.tags, post.data.title) };
};
