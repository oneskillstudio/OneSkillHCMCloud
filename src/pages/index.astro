              <text x="526" y="318" text-anchor="middle" font-family="Verdana, sans-serif" font-size="7.5" fill="#56687E">(DBI Access)</text>
            </g>
            <g>
              <rect x="470" y="172" width="60" height="24" rx="4" fill="#FFFFFF" stroke="#184878" stroke-width="1.1"></rect>
              <text x="500" y="188" text-anchor="middle" font-family="Verdana, sans-serif" font-size="7.5" font-weight="700" fill="#184878">Context_A</text>
            </g>
            <g>
              <rect x="470" y="204" width="118" height="34" rx="4" fill="#F7EFE4" stroke="#C05A10" stroke-width="1.1"></rect>
              <text x="529" y="219" text-anchor="middle" font-family="Verdana, sans-serif" font-size="7.5" font-weight="700" fill="#C05A10">Context</text>
              <text x="529" y="231" text-anchor="middle" font-family="Verdana, sans-serif" font-size="7.5" font-weight="700" fill="#C05A10">Evaluations</text>
